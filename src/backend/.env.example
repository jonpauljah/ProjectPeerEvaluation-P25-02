# Development database; start MongoDB separately.
# MONGO_URI is a legacy fallback; prefer MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017/peer-eval

# Required: replace with a unique random secret.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional: backend defaults to 5000.
PORT=5000

# Frontend origin used in email links.
FRONTEND_URL=http://localhost:3000

# Email configuration: use your development SMTP sandbox.
# Copy host, port, credentials, and sender from your provider.
SMTP_HOST=your-sandbox-smtp-host
SMTP_PORT=587
# false for port 587 with STARTTLS; true for implicit TLS on 465.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=peers-test@example.com

# Optional provider preset; overrides SMTP_HOST and SMTP_PORT.
# Leave unset when using explicit sandbox settings.
# SMTP_SERVICE=gmail
